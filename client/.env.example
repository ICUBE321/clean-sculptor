# Copy this file to .env and .env.development and fill in your actual values

# Backend API URL
VITE_API_BASE_URL=http://localhost:3000

# Edamam Food Database API Credentials
# Get these from: https://developer.edamam.com/food-database-api
VITE_EDAMAM_APP_ID=your_edamam_app_id_here
VITE_EDAMAM_APP_KEY=your_edamam_app_key_here